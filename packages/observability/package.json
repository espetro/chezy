{
  "name": "@chezy/observability",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./logger": "./src/logger.ts",
    "./audit": "./src/audit.ts",
    "./configure": "./src/configure.ts"
  },
  "scripts": {
    "lint": "oxlint src",
    "typecheck": "tsc -b --noEmit",
    "format": "oxfmt \"src/**/*.ts\"",
    "format:check": "oxfmt --check \"src/**/*.ts\"",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@logtape/logtape": "catalog:default",
    "@logtape/file": "catalog:default",
    "@logtape/config": "catalog:default"
  },
  "devDependencies": {
    "oxlint": "catalog:default",
    "oxfmt": "catalog:default",
    "typescript": "catalog:default",
    "vitest": "catalog:default",
    "type-fest": "catalog:default"
  }
}
