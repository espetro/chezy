# apps/bot environment template. Copy to apps/bot/.env (gitignored) and fill in.

# BotFather bot token. Either spelling works; TELEGRAM_BOT_TOKEN wins if both set.
TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_API_KEY=

# Bot @username (optional, used as the display name on connect).
# TELEGRAM_BOT_USERNAME=
# TELEGRAM_BOT_NAME=

# Bot API origin. Default https://api.telegram.org; point at the fake in tests.
# TELEGRAM_API_BASE_URL=http://127.0.0.1:PORT

# Comma-separated Telegram user ids allowed to talk to the bot. Empty = open.
# TELEGRAM_ALLOWED_USER_IDS=

# HTTP port for the Mastra Hono server (agent API + internal routes).
# BOT_PORT=4111

# Bearer token guarding POST /internal/radar/run. Unset = route disabled.
# BOT_INTERNAL_TOKEN=

# Radar loop interval and minimum match score (0-100).
# RADAR_INTERVAL_MS=900000
# RADAR_MIN_SCORE=70

# Shared with apps/web, usually inherited from apps/web/.env.local.
# POSTGRES_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres
# OPENAI_COMPATIBLE_BASE_URL=http://localhost:8317/v1
# OPENAI_COMPATIBLE_API_KEY=
# CHEZY_MODEL_ID=deepseek-ai/DeepSeek-V4.1-Flash
