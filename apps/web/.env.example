# apps/web environment variables
#
# pg0 replaces Neon. The connection URI is whatever `mise run db:status`
# prints after `mise run db:start`. The default is
#
#   postgresql://postgres:postgres@127.0.0.1:5432/postgres
#
# Override these only if you started pg0 with --port, --username,
# --password or --database non-default values.
POSTGRES_URL="postgresql://postgres:postgres@127.0.0.1:5432/postgres"

# OpenAI-compatible LLM provider (lib/ai/providers.ts, lib/ai/models.ts).
# The project provider is Nebius AI Studio; the code default is a local bifrost
# at http://localhost:8317/v1. The model list is fetched from {base}/models.
OPENAI_COMPATIBLE_BASE_URL="https://api.studio.nebius.com/v1"
# OPENAI_COMPATIBLE_API_KEY=""   # the Nebius key (NEBIUS_API_KEY); never commit it
CHEZY_MODEL_ID="deepseek-ai/DeepSeek-V4.1-Flash"
CHEZY_TITLE_MODEL_ID="Qwen/Qwen3-30B-A3B-Instruct-2507"
# Vision model for photo-derived listing insights (lib/vision/). Kimi-K3 is
# the best option on Nebius; google/gemma-3-27b-it is the cheap fallback.
VISION_MODEL_ID="moonshotai/Kimi-K3"
# Same Nebius key, also used by the future smart-KPI feature:
# NEBIUS_API_KEY=""

# Used by chat history / artifact features. A signed secret is required
# in production; for local development any non-empty string works.
AUTH_SECRET="dev-secret-change-me"

# ---------------------------------------------------------------------------
# Viewing / voice agent (server-side only; never exposed to the browser).
# ---------------------------------------------------------------------------
# VIEWING_MODE: mock (simulation only) | slng | vonage. Defaults to mock.
# Automatic >=95% requests and rehearsal ALWAYS simulate, even in a live mode.
# Live calls also require manual opt-in in the UI and this server-only switch:
VIEWING_MODE="mock"
# VIEWING_LIVE_ENABLED="true"
# CALENDAR_MODE: mock (deterministic slot) | google (service-account event).
CALENDAR_MODE="mock"

# Base URL the SLNG `book_viewing` tool calls back to. Must be public in
# deployment for SLNG to reach it.
APP_BASE_URL="http://localhost:3000"

# Vonage Voice API (see apps/web/lib/vonage.ts).
# VONAGE_API_KEY=""
# VONAGE_API_SECRET=""
# VONAGE_FROM_NUMBER="12012556040"
# VONAGE_APPLICATION_ID=""
# VONAGE_PRIVATE_KEY_PATH=""
# VONAGE_PRIVATE_KEY=""

# SLNG Voice Agents API (see apps/web/lib/slng.ts).
# SLNG_API_KEY=""
# SLNG_AGENT_ID=""

# The ONLY permitted live target. Set an authorized team-controlled E.164 number.
# Never set a real agency number for a rehearsal. Mock needs no phone or keys.
# DEMO_AGENCY_PHONE="+34600000000"
# Live retries reuse request IDs. Receipts are process-local: operate the live
# demo on one long-lived server. Retries with a lost receipt fail closed after a
# restart or on a different worker; an operator must check provider history.
# Multi-instance production needs durable idempotency before enabling live calls.
# latencyMs = server request entry to provider dispatch acknowledgement (includes
# validation, auth and listing lookup); NOT answer time or conversational latency.
# A dispatched result has no appointment slot. No booking completion is wired.

# Google Calendar (CALENDAR_MODE=google).
# GOOGLE_CALENDAR_ID=""
# GOOGLE_SERVICE_ACCOUNT_JSON_PATH=""

# Embeddings for cross-chat memory (lib/ai/embeddings.ts). Uses the same
# OpenAI-compatible provider as the chat models above.
# CHEZY_EMBEDDING_MODEL_ID="Qwen/Qwen3-Embedding-8B"
