# apps/web environment variables
#
# pg0 replaces Neon. The connection URI is whatever `mise run db:status`
# prints after `mise run db:start`. The default is
#
#   postgresql://postgres:postgres@127.0.0.1:5432/postgres
#
# Override these only if you started pg0 with --port, --username,
# --password or --database non-default values.
POSTGRES_URL="postgresql://postgres:postgres@127.0.0.1:5432/postgres"

# Vercel AI Gateway. In Vercel deployments this is set automatically via
# OIDC; locally and on other hosts you need a real key from
# https://vercel.com/dashboard → AI Gateway.
# AI_GATEWAY_API_KEY=""

# Used by chat history / artifact features. A signed secret is required
# in production; for local development any non-empty string works.
AUTH_SECRET="dev-secret-change-me"
